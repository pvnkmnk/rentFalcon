# rentFalcon (Rental Scanner) environment configuration
# Copy to .env and fill in real values before deploying:
#   cp .env.example .env

# --- REQUIRED: session signing key -----------------------------------------
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Containerized deployments REFUSE to start without it (FLASK_ENV=docker).
SECRET_KEY=

# --- Web -------------------------------------------------------------------
WEB_PORT=5000
FLASK_ENV=docker

# --- Database (PostgreSQL) --------------------------------------------------
POSTGRES_DB=rental_scanner
POSTGRES_USER=rental_user
# Set a real password; the compose default exists only for first boot.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Application ------------------------------------------------------------
MULTI_USER_ENABLED=true
REQUIRE_LOGIN=true
MAX_SAVED_SEARCHES_PER_USER=10

# --- Scrapers ---------------------------------------------------------------
ENABLED_SCRAPERS=kijiji,realtor,rentals,viewit,apartments
SCRAPER_TIMEOUT=30
SCRAPER_DELAY=1

# --- Email (optional) -------------------------------------------------------
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@rentalscanner.local

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
